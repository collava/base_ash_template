{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "config:best-practices",
    "schedule:automergeDaily",
    "security:openssf-scorecard",
    "mergeConfidence:all-badges"
  ],
  "constraints": {
    "erlang": "29.1.2",
    "elixir": "1.20.5"
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "matchManagers": ["mix"],
      "addLabels": ["deps", "hex"]
    },
    {
      "matchManagers": ["npm"],
      "addLabels": ["deps", "npm"]
    },
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    }
  ]
}
